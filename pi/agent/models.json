{
  "$schema": "https://pi.dev/schemas/models.schema.json",
  "providers": {
    "inkling": {
      "baseUrl": "http://127.0.0.1:8080/v1",
      "api": "openai-completions",
      "apiKey": "local-no-key",
      "compat": {
        "maxTokensField": "max_tokens",
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": false,
        "thinkingFormat": "chat-template",
        "chatTemplateKwargs": {
          "reasoning_effort": {
            "$var": "thinking.effort"
          }
        }
      },
      "models": [
        {
          "id": "inkling-2-mini",
          "name": "Inkling 2 Mini (local llama.cpp, GSQ-RCO-Q2_K_XL)",
          "reasoning": true,
          "thinkingLevelMap": {
            "off": "none",
            "minimal": "minimal",
            "low": "low",
            "medium": "medium",
            "high": "high",
            "xhigh": null,
            "max": null
          },
          "input": [
            "text",
            "image"
          ],
          "contextWindow": 24576,
          "maxTokens": 4096,
          "cost": {
            "input": 0,
            "output": 0,
            "cacheRead": 0,
            "cacheWrite": 0
          },
          "samplingParams": {
            "temperature": 1.0,
            "top_p": 1.0,
            "top_k": 0,
            "min_p": 0.0
          },
          "inputLimits": {
            "images": {
              "resize": {
                "maxWidth": 1024,
                "maxHeight": 1024,
                "maxBytes": 800000,
                "jpegQuality": 85
              },
              "maxPerMessage": 1,
              "maxPerRequest": 2
            }
          }
        }
      ]
    }
  }
}